#!/bin/sh
# Pre-push hook for prime-game-art. GitHub Free has no branch protection on a private repository, so this local hook
# is the guard: it refuses a push to main and a deletion of main (only the engineer merges into main, on GitHub).
# `tools/run.py doctor` sets core.hooksPath to tools/githooks. core.hooksPath switches off the hooks Git LFS installs
# in .git/hooks, so this hook runs `git lfs pre-push` itself.

input=$(cat)
blocked=0

is_zero() {
  printf '%s' "$1" | grep -Eq '^0+$'
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "$remote_ref" ] || continue
  [ "$remote_ref" = refs/heads/main ] || continue
  if is_zero "$local_oid"; then
    printf 'pre-push: refused the deletion of main\n  -> main is deleted by nobody; only the engineer changes it, on GitHub.\n' >&2
  else
    printf 'pre-push: refused a push to main\n  -> Push the task branch (git push -u origin <branch>) and open a pull request; only the engineer merges into main.\n' >&2
  fi
  blocked=1
done <<EOF
$input
EOF

[ "$blocked" -eq 0 ] || exit 1

if ! command -v git-lfs >/dev/null 2>&1; then
  printf '\npre-push: Git LFS is not installed, and this repository uses it.\n  -> Install it (it comes with Git for Windows), then run: git lfs install --skip-repo\n\n' >&2
  exit 2
fi
[ -z "$input" ] || printf '%s\n' "$input" | git lfs pre-push "$@"
